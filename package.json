{
  "name": "openink",
  "version": "0.1.1",
  "description": "Describe screens in YAML, get a clickable hand-drawn wireframe prototype (static HTML, PDF, PNG). Built on wired-elements and RoughJS.",
  "keywords": [
    "wireframe",
    "prototype",
    "sketch",
    "mockup",
    "hand-drawn",
    "wired-elements",
    "roughjs",
    "ux",
    "static-site-generator"
  ],
  "license": "MIT",
  "author": "Mediusware",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mediuswareltd/openink.git"
  },
  "homepage": "https://mediuswareltd.github.io/openink/",
  "bugs": {
    "url": "https://github.com/mediuswareltd/openink/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "openink": "bin/openink.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./schema.json": "./schema/spec.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "schema",
    "docs",
    "!docs/img",
    "!docs/.vitepress",
    "!docs/public",
    "!docs/index.md",
    "!docs/examples.md",
    "!docs/about.md",
    "!docs/snippets",
    "!docs/recipes.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node scripts/generate.js",
    "test": "node --test \"test/*.test.js\"",
    "prepare": "node scripts/setup-hooks.js",
    "prepublishOnly": "npm test",
    "lint:commit": "node scripts/commit-lint.js",
    "screenshots": "node scripts/screenshots.js",
    "dev": "node bin/openink.js dev examples/rental-portal",
    "docs:demos": "node scripts/build-demos.js",
    "docs:dev": "npm run docs:demos && vitepress dev docs",
    "docs:build": "npm run docs:demos && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "npm run docs:build && node scripts/deploy-docs.js"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.12.0",
    "roughjs": "4.3.1",
    "wired-elements": "3.0.0-rc.6",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
