{
  "name": "openink",
  "version": "0.1.0",
  "description": "Describe screens in YAML, get a clickable hand-drawn wireframe prototype (static HTML, PDF, PNG). Built on wired-elements and RoughJS.",
  "keywords": ["wireframe", "prototype", "sketch", "mockup", "hand-drawn", "wired-elements", "roughjs", "ux", "static-site-generator"],
  "license": "MIT",
  "author": "Mediusware",
  "repository": { "type": "git", "url": "git+https://github.com/mediuswareltd/openink.git" },
  "homepage": "https://github.com/mediuswareltd/openink#readme",
  "bugs": { "url": "https://github.com/mediuswareltd/openink/issues" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "bin": { "openink": "bin/openink.js" },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./schema.json": "./schema/spec.schema.json",
    "./package.json": "./package.json"
  },
  "files": ["bin", "src", "templates", "schema", "docs", "!docs/img", "LICENSE", "README.md", "CHANGELOG.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "generate": "node scripts/generate.js",
    "test": "node --test \"test/*.test.js\"",
    "prepublishOnly": "npm test",
    "screenshots": "node scripts/screenshots.js",
    "dev": "node bin/openink.js dev examples/rental-portal"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.12.0",
    "roughjs": "4.3.1",
    "wired-elements": "3.0.0-rc.6",
    "yaml": "^2.5.0"
  }
}
